{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invention",
  "type": "object",
  "required": ["id", "title", "summary", "inventors"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "inventors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
