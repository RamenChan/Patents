{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PriorArt",
  "type": "object",
  "required": ["id", "invention_id", "title", "summary"],
  "properties": {
    "id": {"type": "string"},
    "invention_id": {"type": "string"},
    "title": {"type": "string"},
    "url": {"type": ["string", "null"]},
    "publication_date": {"type": ["string", "null"]},
    "summary": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
